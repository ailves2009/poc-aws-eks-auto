# .gitignore for Terraform and Kubernetes project

**/*.tfstate
.terraform
**/*.crt
**/*.key
**/*.csr
**/*.pem
docs/
temp/
data/
**/eks-deploy
*-secret.yaml
!*-sealed-secret.yaml

# Terragrunt cache and generated files
.terragrunt-cache/
**/.terragrunt-cache/

# Local kubeconfig
kubeconfig
*.kubeconfig
~/.kube/

# Terraform local variables
*.tfvars.local
terraform.tfvars.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Python
__pycache__/
*.py[cod]
venv/
.env

# Node
node_modules/
package-lock.json

# Local archives
*.tar.gz
